# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
HOST=localhost
NODE_ENV=development

APP_NAME=ai-code-review
API_VERSION=1.0.0

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai-code-review

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
COOKIE_SECRET=your-cookie-secret-change-this-in-production
COOKIE_SECURE=false   # Set to true in production (HTTPS only)

# ─── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps/new
# Name: AI Code Review (or your preferred name)
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:4000/api/v1/auth/github/callback
# Setup URL: http://localhost:4000/api/v1/github/callback
# Webhook URL: https://your-tunnel.example.com/api/v1/webhooks/github
# Webhook Secret: generate with openssl rand -hex 32
# Permissions needed:
#   - Repository: Contents (read), Pull requests (read/write), Metadata (read)
#   - Subscribe to events: Pull request
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
# Paste the entire PEM key, replacing newlines with \n
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | gemini
AI_PROVIDER=mock

# Required if AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini

# ─── AI Cost Controls ─────────────────────────────────────────────────────────
MAX_FILES_PER_REVIEW=30
MAX_FILE_SIZE_BYTES=100000
MAX_REVIEW_TOKENS=100000
MAX_AI_RETRIES=3

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
